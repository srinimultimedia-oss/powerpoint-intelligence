<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- auto uses the common Office 16 API; explicit profiles record deployment intent. -->
    <add key="OfficeProfile" value="auto" />
    <!-- any, x86 or x64: this checks the running Office process, not the Windows OS. -->
    <add key="OfficeArchitecture" value="any" />
    <!-- Set a four-part build only after validating that build in the target estate. -->
    <add key="OfficeMinimumVersion" value="16.0" />
  </appSettings>
</configuration>
