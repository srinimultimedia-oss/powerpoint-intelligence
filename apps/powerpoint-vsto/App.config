<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- auto uses the common Office 16 API; explicit profiles record deployment intent. -->
    <add key="OfficeProfile" value="auto" />
    <!-- any, x86 or x64: this checks the running Office process, not the Windows OS. -->
    <add key="OfficeArchitecture" value="any" />
    <!-- Set a four-part build only after validating that build in the target estate. -->
    <add key="OfficeMinimumVersion" value="16.0" />
    <!-- Local template packages for this computer; relative paths resolve beside the deployed DLL. -->
    <add key="TemplateLibraryFolder" value="C:\Srini\powerpoint-intelligence\powerpoint-intelligence\apps\powerpoint-vsto\templates" />
    <!-- Empty index path uses the current user's local application data; no presentation content is sent externally. -->
    <add key="LibraryIndexPath" value="" />
    <add key="LibrarySourcesConfig" value="" />
    <add key="LibraryRefreshSeconds" value="60" />
    <add key="LibraryWatchRootLimit" value="32" />
  </appSettings>
</configuration>